# =============================================================================
# Aliases
# ============================================================================

alias re-source="source ~/.zshrc"

## Folder Aliases
alias dotfiles="cd ~/.dotfiles"
alias repositories="cd ~/Developer/Repositories"
alias skills="cd ~/.agents/skills"
alias vault='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/Exocortex'

## Parent Dirs
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."


## General Application
alias v="nvim"
alias vim="nvim"
alias cat="bat"

## Eza
alias ls="eza --long --all --icons=always"
alias lsd="eza --long --all --icons=always --group-directories-first"

## Git
alias gc="git commit -m"
alias gca="git commit -a -m"
alias gp="git push origin HEAD"
alias gpu="git pull origin"
alias gst="git status"
alias glog="git log --graph --topo-order --pretty='%w(100,0,6)%C(yellow)%h%C(bold)%C(black)%d %C(cyan)%ar %C(green)%an%n%C(bold)%C(white)%s %N' --abbrev-commit"
alias gdiff="git diff"
alias gco="git checkout"
alias gb='git branch'
alias gba='git branch -a'
alias gadd='git add'
alias ga='git add -p'
alias gcoall='git checkout -- .'
alias gr='git remote'
alias gre='git reset'


## Docker
alias dco="docker compose"
alias dps="docker ps"
alias dpa="docker ps -a"
alias dl="docker ps -l -q"
alias dx="docker exec -it"


