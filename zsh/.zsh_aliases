# =============================================================================
# Aliases
# =============================================================================

alias ".."="cd .."
alias re-source="source ~/.zshrc"

alias ls="eza --long --all --icons=always"
alias lsd="eza --long --all --icons=always --group-directories-first"

alias dotfiles="cd ~/.dotfiles"
alias repositories="cd ~/Developer/Repositories"

alias skills="cd ~/.agents/skills"

alias vaults="cd ~/Documents/Vaults"
alias exocortex='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/Exocortex'

